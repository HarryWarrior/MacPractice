# ── Entorno ───────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False

# ── API Keys (Configurar en Hugging Face Secrets o servidor) ──
GEMINI_API_KEY=tu-gemini-api-key-produccion
OPENAI_API_KEY=tu-openai-api-key-produccion

# ── Modelos de IA ─────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# ── Gmail (App Password) ─────────────────────────────────
GMAIL_SENDER_EMAIL=tu-email-produccion@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Gradio ────────────────────────────────────────────────
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# ── Rate Limiting ─────────────────────────────────────────
BATCH_DELAY_SECONDS=5
